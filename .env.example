# ==========================================
# CẤU HÌNH DỰ ÁN GEM (LUSTRA_GEM) - AISC 2026
# ==========================================

# 1. Cơ sở dữ liệu quan hệ (PostgreSQL)
POSTGRES_USER=gem_admin
POSTGRES_PASSWORD=gem_secret_password
POSTGRES_DB=gem_database
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# 2. Cơ sở dữ liệu Vector (Qdrant)
QDRANT_PORT=6333
QDRANT_HOST=localhost

# 3. FlareSolverr (Vượt Cloudflare cho TopCV)
FLARESOLVERR_URL=http://localhost:8191/v1

# 4. Cơ sở dữ liệu Cloud (Neon.tech - Dùng chung cho Team)
CLOUD_DB_URL=postgresql://neondb_owner:your_password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 5. Token GitHub (Để cào đồ án sinh viên không bị hạn chế Rate Limit)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# 6. LLM API Key (Dùng cho Golden Set & trích xuất kỹ năng)
GEMINI_API_KEY=your_gemini_api_key_here
# QWEN_BASE_URL=http://localhost:8000/v1
